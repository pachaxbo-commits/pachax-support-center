rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'superadmin' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUserDoc().data.role == 'superadmin'));
    }

    function isDevStaff(devCompanyId) {
      return isAuthenticated() &&
        (isSuperAdmin() ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUserDoc().data.developerCompanyId == devCompanyId &&
          currentUserDoc().data.role in ['dev_owner', 'dev_admin', 'dev_engineer', 'dev_commercial']));
    }

    function isClientUser(clientCompanyId) {
      return isAuthenticated() &&
        (isSuperAdmin() ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUserDoc().data.clientCompanyId == clientCompanyId &&
          currentUserDoc().data.role in ['client_admin', 'client_user']));
    }

    function isClientAdmin(clientCompanyId) {
      return isAuthenticated() &&
        (isSuperAdmin() ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUserDoc().data.clientCompanyId == clientCompanyId &&
          currentUserDoc().data.role == 'client_admin'));
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'developerCompanyId', 'clientCompanyId']);
      allow write: if isSuperAdmin();
    }

    // --- Developer Companies ---
    match /developerCompanies/{companyId} {
      allow read: if isDevStaff(companyId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // --- Client Companies ---
    match /clientCompanies/{clientId} {
      allow read: if isClientUser(clientId) ||
        (isAuthenticated() && isDevStaff(resource.data.developerCompanyId));
      allow create, update: if isAuthenticated() &&
        (isSuperAdmin() || isDevStaff(request.resource.data.developerCompanyId));
      allow delete: if isSuperAdmin();
    }

    // --- Projects ---
    match /projects/{projectId} {
      allow read: if isAuthenticated() &&
        (isClientUser(resource.data.clientCompanyId) || isDevStaff(resource.data.developerCompanyId));
      allow write: if isAuthenticated() &&
        (isSuperAdmin() || isDevStaff(request.resource.data.developerCompanyId));
    }

    // --- App Installations / SDK Connections ---
    match /appInstallations/{installId} {
      allow read: if isAuthenticated() &&
        (isDevStaff(resource.data.developerCompanyId) || isClientUser(resource.data.clientCompanyId));
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (isDevStaff(resource.data.developerCompanyId) || isSuperAdmin());
    }

    // --- Incident Reports (Batch Containers) ---
    match /incidentReports/{reportId} {
      allow read: if isAuthenticated() &&
        (isClientUser(resource.data.clientCompanyId) || isDevStaff(resource.data.developerCompanyId));
      allow create: if isAuthenticated() &&
        isClientUser(request.resource.data.clientCompanyId) &&
        request.resource.data.keys().hasAll(['clientCompanyId', 'developerCompanyId', 'projectId', 'createdAt', 'category']);
      allow update: if isAuthenticated() &&
        (isDevStaff(resource.data.developerCompanyId) ||
         (isClientUser(resource.data.clientCompanyId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'assignedTo', 'developerCompanyId', 'clientCompanyId'])));
    }

    // --- Incident Items (Sub-errors) ---
    match /incidentItems/{itemId} {
      allow read: if isAuthenticated() &&
        (isClientUser(resource.data.clientCompanyId) || isDevStaff(resource.data.developerCompanyId));
      allow create: if isAuthenticated() &&
        isClientUser(request.resource.data.clientCompanyId);
      allow update: if isAuthenticated() &&
        (isDevStaff(resource.data.developerCompanyId) ||
         (isClientUser(resource.data.clientCompanyId) &&
          request.resource.data.clientCompanyId == resource.data.clientCompanyId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'assignedTo', 'aiFixEligible', 'aiFixStatus'])));
    }

    // --- Feature Requests ---
    match /featureRequests/{requestId} {
      allow read: if isAuthenticated() &&
        (isClientUser(resource.data.clientCompanyId) || isDevStaff(resource.data.developerCompanyId));
      allow create: if isAuthenticated() &&
        isClientUser(request.resource.data.clientCompanyId);
      allow update: if isAuthenticated() &&
        (isDevStaff(resource.data.developerCompanyId) ||
         (isClientUser(resource.data.clientCompanyId) &&
          request.resource.data.clientCompanyId == resource.data.clientCompanyId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'quoteId', 'estimatedHours'])));
    }

    // --- Quotes ---
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() &&
        (isClientUser(resource.data.clientCompanyId) || isDevStaff(resource.data.developerCompanyId));
      allow create, update: if isAuthenticated() &&
        (isDevStaff(request.resource.data.developerCompanyId) ||
         (isClientAdmin(resource.data.clientCompanyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'rejectedAt', 'rejectionReason', 'approvedBy'])));
    }

    // --- AI Repair Runs ---
    match /aiRepairRuns/{runId} {
      allow read, write: if isAuthenticated() &&
        (isDevStaff(resource.data.developerCompanyId) || isSuperAdmin());
    }

    // --- Audit Logs ---
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() &&
        (isDevStaff(resource.data.developerCompanyId) || isSuperAdmin());
      allow write: if false; // Cloud Functions / Server backend only
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024; // 10 MB max
    }

    function isDocument() {
      return (request.resource.contentType.matches('application/pdf') ||
              request.resource.contentType.matches('text/.*') ||
              request.resource.contentType.matches('application/json')) &&
        request.resource.size < 25 * 1024 * 1024; // 25 MB max
    }

    // Tenant-isolated storage path:
    // /tenants/{developerCompanyId}/clients/{clientCompanyId}/projects/{projectId}/...
    match /tenants/{devId}/clients/{clientId}/projects/{projId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isImage() || isDocument());
    }

    // Public / branding assets
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

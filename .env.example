# ==========================================
# PACHAX SUPPORT CENTER — ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env.local for local development.
# In production, set these variables in your Vercel Project Settings.

# Firebase Web App Configuration (Required)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=pachax-support-center.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pachax-support-center
VITE_FIREBASE_STORAGE_BUCKET=pachax-support-center.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=536862838309
VITE_FIREBASE_APP_ID=1:536862838309:web:89e2c476b758c2ddeb39cc
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check (Production only - Optional in Dev)
VITE_APP_CHECK_DEBUG_TOKEN=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Application Mode: 'live' uses real Firebase services; 'demo' enables realistic sandbox preview
VITE_APP_MODE=live

# PACHAX Support Center Public Branding
VITE_APP_NAME="PACHAX Support Center"
VITE_SUPPORT_DOMAIN=support.pachax.bo

# Cloud Functions Base URL (Gen 2)
VITE_FUNCTIONS_BASE_URL=https://us-central1-pachax-support-center.cloudfunctions.net

# Firebase Emulators (true to connect to local emulators)
VITE_USE_FIREBASE_EMULATORS=false
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_STORAGE_PORT=9199
VITE_EMULATOR_FUNCTIONS_PORT=5001
